<component type="desktop-application">
  <id>io.github.luohoa97.LibreDAW</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>LibreDAW</name>
  <summary>Make beats and music on your desktop</summary>
  <developer id="io.github.luohoa97">
    <name>The LibreDAW developers</name>
  </developer>
  <description>
    <p>LibreDAW is a free digital audio workstation for Linux that you can pick up and use right away. Start from a beat template, click steps into a drum pattern, play notes, arrange the song and mix it.</p>
    <p>It is built with GTK 4 and libadwaita, so it looks and behaves like the rest of your desktop.</p>
    <ul>
      <li>Home page with templates for Phonk, Trap, Boom Bap, Lo-fi and House beats</li>
      <li>Step sequencer, note editor, song view and mixer</li>
      <li>Built-in sound packs, free to use for any purpose</li>
      <li>CLAP plugin hosting</li>
      <li>A guided first-beat tutorial</li>
      <li>AI agents can work inside your project through MCP, visibly, and only with your approval</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.luohoa97.LibreDAW.desktop</launchable>
  <url type="homepage">https://github.com/luohoa97/LibreDAW</url>
  <url type="bugtracker">https://github.com/luohoa97/LibreDAW/issues</url>
  <provides>
    <binary>libredaw</binary>
    <binary>libredaw-mcp</binary>
    <mediatype>application/x-libredaw-project</mediatype>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
    <category>Music</category>
  </categories>
  <keywords>
    <keyword>beat</keyword>
    <keyword>drum machine</keyword>
    <keyword>sequencer</keyword>
    <keyword>music production</keyword>
  </keywords>
  <content_rating type="oars-1.1"/>
