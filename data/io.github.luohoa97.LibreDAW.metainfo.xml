  </screenshots>
  <releases>
    <release version="0.1.0" date="2026-10-07">
      <description>
        <p>First release.</p>
        <ul>
          <li>Home page with templates, recent projects and recovery of unsaved work</li>
          <li>Welcome tour and an interactive "Make Your First Beat" tutorial</li>
          <li>Pattern, Song and Mixer views, with a real-time audio engine</li>
          <li>Built-in CC0 sound packs</li>
          <li>CLAP plugin hosting</li>
          <li>MCP control for AI agents, with visible activity and approvals</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
